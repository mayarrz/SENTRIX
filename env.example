VITE_API_BASE_URL=/api/v1
VITE_USE_REAL_BACKEND=true

# Management API binds to loopback only. Admin operations reject all requests
# until a unique, locally stored token is configured. Never expose this token
# in a VITE_ variable or commit a populated .env file.
API_HOST=127.0.0.1
API_PORT=5000
ADMIN_TOKEN=generate-with-node-crypto-before-running
CORS_ORIGIN=http://127.0.0.1:3000
SENTRIX_DB_PATH=backend/sentrix.sqlite

# Separate honeypot listener; keep on loopback unless doing an authorized test.
HONEYPOT_HOST=127.0.0.1
HONEYPOT_PORT=5001
API_RATE_LIMIT=120
API_RATE_WINDOW_MS=60000
HONEYPOT_RATE_LIMIT=30
HONEYPOT_RATE_WINDOW_MS=60000
# Backend PORT=5000; development Vite proxy forwards /api
